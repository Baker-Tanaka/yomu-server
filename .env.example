BIND_ADDR=127.0.0.1:8080
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:e4b-it-qat
LLM_DISABLE_THINKING=true
DATABASE_URL=sqlite://data/app.db
STATIC_DIR=crates/web/dist
ALLOWED_HOSTS=arxiv.org,www.arxiv.org
RUST_LOG=info,tower_http=info,sqlx=warn
# 文法タグのマスターと、講座のレッスン対応（local が無ければテンプレートを読む）
GRAMMAR_TAGS_PATH=data/grammar_tags.yaml
GRAMMAR_MAP_PATH=data/grammar_map.local.yaml
GRAMMAR_MAP_TEMPLATE_PATH=data/grammar_map.template.yaml
# 単語帳（検索回数・カタカナの読み・辞書に無い語の AI 訳）に残す語数の上限。超えたら検索回数の少ない語から消す
WORD_STORE_MAX=20000
# 不具合・要望を GitHub の Issue にする（未設定なら、この Mac に保存だけする）
# トークンは Fine-grained token で、対象リポジトリだけ・Issues: Read and write だけを許可する
# scripts/setup_env.sh を実行すると、GITHUB_REPO は git remote から入り、トークンは画面に出さずに入力・検証できる
GITHUB_REPO=
GITHUB_TOKEN=
