<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  スリープ防止（任意）。電源接続中のシステムスリープと、アイドルによるスリープを防ぐ。
  ディスプレイは通常どおり消える。蓋を閉じたときのスリープは防げない（deploy/lid.sh を使う。docs/operations.md を参照）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.paper-reader.caffeinate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
